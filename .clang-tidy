Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  performance-*,
  -performance-enum-size,
  portability-*,
  -portability-avoid-pragma-once,
  modernize-use-nullptr,
  modernize-use-override
WarningsAsErrors: '*'
HeaderFilterRegex: '^.*/(include|src|tests|tools)/'
ExcludeHeaderFilterRegex: '^.*/(build[^/]*|out|cmake-build-[^/]*|_deps|[^/]*_autogen)/'
FormatStyle: file
SystemHeaders: false
CheckOptions:
  bugprone-exception-escape.CheckMain: false
