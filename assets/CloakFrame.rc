// Resource id 1 is CREATEPROCESS_MANIFEST_RESOURCE_ID and type 24 is RT_MANIFEST. The
// numbers are used directly so the script needs no Windows headers and also assembles with
// windres. The linker must not add its own manifest as well; see src/CMakeLists.txt.
1 24 "CloakFrame.manifest"
